  "deselect": [
    {
      "reason": "runs `sys.executable -m timeit` twice in a subprocess, once with `import path`, and asserts on a 20 ms limit: the tracer does not record a child process, and the child writes bytecode into the source copy (its environment has no PYTHONDONTWRITEBYTECODE)",
      "test": "tests/test_path.py::TestPerformance::test_import_time"
    },
    {
      "reason": "runs `sys.executable -S -c 'import path'` in a subprocess: the tracer does not record a child process, and the child writes bytecode into the source copy (its environment has no PYTHONDONTWRITEBYTECODE)",
      "test": "tests/test_path.py::test_no_dependencies"
    }
  ],
