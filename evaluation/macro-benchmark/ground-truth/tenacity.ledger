# Call-site ledger of tenacity at 4410996dd9a96864a2733ce0778bcaa112b72811.
# Hand-written from the source; judgements in tenacity.md.
#
# Strategy sets used below (the package values a client can pass for a role,
# plus the package defaults; see tenacity.md, "Open-set dispatch"):
#   stop (7): the __call__ of stop_any, stop_all, _stop_never,
#     stop_when_event_set, stop_after_attempt, stop_after_delay,
#     stop_before_delay (stop_base.__call__ is abstract).
#   wait (9): the __call__ of wait_fixed (also wait_none), wait_random,
#     wait_combine, wait_chain, wait_exception, wait_incrementing,
#     wait_exponential, wait_random_exponential, wait_exponential_jitter.
#   sync retry (10): the __call__ of _retry_never, _retry_always,
#     retry_if_exception (also _type, _not_exception_type, _exception_message),
#     retry_unless_exception_type, retry_if_exception_cause_type,
#     retry_if_result, retry_if_not_result, retry_if_not_exception_message,
#     retry_any, retry_all.
#   async retry (4): the __call__ of tenacity.asyncio.retry.retry_if_exception,
#     retry_if_result, retry_any, retry_all.
#   hooks (6): before_nothing, before_log.log_it, after_nothing,
#     after_log.log_it, before_sleep_nothing, before_sleep_log.log_it.
#   sleep: tenacity.nap.sleep, sleep_using_event.__call__, and the default of
#     the class: _portable_async_sleep (AsyncRetrying), tornado.gen.sleep
#     (TornadoRetrying).
default reject tenacity._RetryDecorated.__get__: _RetryDecorated is a typing.Protocol that the package never instantiates (only t.cast names it), and both of its __get__ definitions are @t.overload stubs; no class attribute that an attribute load finds is an instance of it, so its __get__ never runs
default reject tenacity.retry.retry_base.__or__, tenacity.retry.retry_base.__ror__, tenacity.retry.retry_any.__ror__, tenacity.asyncio.retry.async_retry_base.__or__, tenacity.asyncio.retry.async_retry_base.__ror__, tenacity.asyncio.retry.retry_any.__ror__, tenacity.stop.stop_base.__or__: every `|` in the package is a type union in an annotation or a type alias; its operands are classes (type.__or__), typing forms, TypeVars or None, never instances of the strategy classes whose __or__/__ror__ are instance methods
default reject tenacity.BaseRetrying.__iter__, tenacity.asyncio.AsyncRetrying.__iter__: no for loop, comprehension, star-unpacking, `in` test or builtin that can iterate (any, all, sum, set, min, max) in the package operates on a retrying object; they operate on tuples (*args, *dargs, retries, stops, wait_funcs, REPR_FIELDS), the actions list of IterState, dict views, sys.modules, a set, generator expressions over those tuples, nothing (set()), or several numbers (every min and max gets two or more numeric arguments, so it iterates nothing)
default reject tenacity.wait.wait_base.__add__, tenacity.wait.wait_base.__radd__: every `+`, `+=` and sum() in the package adds numbers (floats that wait strategies return, statistics counters, attempt numbers) or tuples (WRAPPER_ASSIGNMENTS), never wait strategies

