import sys
from abc import abstractmethod
from collections.abc import Iterable
from typing import Any, AnyStr, Callable, Generic, Literal, Optional, Protocol, Self, TypeVar, overload

_T = TypeVar("_T")
_Number = int | float
_Handler = Callable[[str], None]

__all__ = ["Shape", "Circle", "Figure", "area", "scale", "Runner"]

class _Callback(Protocol):
    def __call__(self, value: int, /) -> str: ...

class Shape(Generic[_T]):
    sides: int
    @property
    def name(self) -> str: ...
    @name.setter
    def name(self, value: str) -> None: ...
    @abstractmethod
    def area(self) -> float: ...
    def copy(self) -> Self: ...
    @classmethod
    def unit(cls) -> Shape[int]: ...
    @staticmethod
    def kinds() -> list[str]: ...
    class Edge:
        def length(self) -> int: ...
    alias = copy

class Circle(Shape[float]):
    if sys.version_info >= (3, 12):
        def __init__(self, radius: float, *, label: str = "") -> None: ...
    else:
        def __init__(self, radius: float) -> None: ...
    def area(self) -> float: ...
    def scaled(self, __factor: float) -> Self: ...

if sys.platform == "win32":
    class Runner:
        def run(self, task: _Handler) -> None: ...
else:
    class Runner:
        def start(self, task: _Callback | None = None) -> None: ...

@overload
def area(shape: Shape[_T], /) -> float: ...
@overload
def area(shape: None, /) -> Literal[0]: ...
def opened(mode: Literal["r", "w"] | Literal["w", "a"] | None, buffering: Literal[-1, 1, True, b"x"]) -> None: ...
def scale(shape: Shape[_T], factor: Optional[float] = None, *factors: float, key: Callable[[_T], int], **options: Any) -> Shape[_T]: ...
def pattern(text: AnyStr) -> list[AnyStr]: ...
def identity(value: _T) -> _T: ...
def make(cls: type[_T]) -> _T: ...
async def wait(delay: float) -> None: ...
def legacy(__a: int, __b: int, c: int) -> None: ...

class _Hidden: ...

Figure = Shape

_default: Circle
default_area = _default.area
default_kinds = _default.kinds

_P = ParamSpec("_P")
def submit(fn: Callable[_P, int], *args: _P.args, **kwargs: _P.kwargs) -> None: ...

if sys.version_info >= (3, 12):
    from shapes._extra import Extra as Extra
else:
    class Extra:
        def old(self) -> int: ...
